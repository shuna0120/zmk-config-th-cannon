#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

/* --- Scroll tuning --- */
 / {
  msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms  = <200>;
    delay-ms              = <5>;
  };

  behaviors {
    // エンコーダー：キー
    rot_kp: sensor_rotate_kp {
      compatible = "zmk,behavior-sensor-rotate-var";
      #sensor-binding-cells = <2>;
      bindings = <&kp>, <&kp>;
    };

    // エンコーダー：マウススクロール（未使用でも残してOK）
    rot_msc: sensor_rotate_msc {
      compatible = "zmk,behavior-sensor-rotate-var";
      #sensor-binding-cells = <2>;
      tap-ms = <20>;
      bindings = <&msc>, <&msc>;
    };

    // エンコーダー：マウススクロール(MOVE_Y)
    scroll_move_y: sensor_rotate_msc_for_move_y {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(-20)>;
      // tap-ms下限メモ: Y(20)なら ~65ms 付近が安定
      tap-ms = <65>;
    };

    // エンコーダー：マウススクロール(MOVE_X)
    scroll_move_x: sensor_rotate_msc_for_move_x {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&msc MOVE_X(20)>, <&msc MOVE_X(-20)>;
      // tap-ms下限メモ: X(20)なら ~65ms 付近が安定
      tap-ms = <65>;
    };
  };

  /* --- Keymap --- */
  keymap {
    compatible = "zmk,keymap";

    /* Windows用ベース */
    DEFAULT_WIN {
      bindings = <
        // Order when USB is on top
        // Keys (Upper-right to Lower-left)
        &kp K_PLAY_PAUSE      &kp C_NEXT   &kp C_PREV    &kp C_VOL_UP
        &kp C_FAST_FORWARD    &mo SCROLL  &kp LC(N0)   &kp K_VOLUME_UP
        &kp C_FAST_FORWARD    &kp TAB     &kp LS(TAB)  &kp C_REWIND
        // Mouse (Left, Right)
        &kp C_VOL_DN  &kp K_VOLUME_UP2
        // Stick (Up, Left, Down, Right)
        &kp LS(LC(T)) &kp LS(LC(TAB)) &kp LC(W) &kp LC(TAB)
        // Lever (Left-side-left to Right-side-right)
        &to DEFAULT_WIN &kp F11 &to DEFAULT_WIN
        &to DEFAULT_WIN &kp F12 &to DEFAULT_WIN
        // Side (Upper-left, Lower-left, Upper-right, Lower-right)
        &kp C_MUTE &kp K_MUTE &kp F3 &kp F4
        // Back (Upper, Lower)
        &bt BT_SEL 0 &bt BT_SEL 1
      >;

      // Encoder ( Upper CCW/CW, Middle Up/Down, Left Up/Down )
      sensor-bindings = <&rot_kp LG(Z) LS(LG(Z))>, <&scroll_move_y>, <&rot_kp LG(PLUS) LG(MINUS)>;
      // ※ Win専用運用なら上の LG(PLUS/MINUS) を LC(PLUS/MINUS) に変えるのもアリ
    };

    /* スクロール／BTユーティリティ層（旧：SETTINGS） */
    SCROLL {
      bindings = <
        // Key
        &none &none &none &none
        &none &none &none &none    // ← 自己参照(&mo SCROLL)は削除
        &none &none &none &none
        // Mouse
        &none &none
        // Stick
        &none &none &none &none
        // Lever
        &none &none &none
        &none &none &none
        // Side
        &none &none &none &none
        // Back
        &bt BT_CLR_ALL &bt BT_CLR
      >;

      // Encoder: 垂直／水平スクロールに切替
      sensor-bindings = <&rot_kp LEFT RIGHT>, <&scroll_move_y>, <&scroll_move_x>;
    };
  };
};
