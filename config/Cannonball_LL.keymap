#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

#define DEFAULT_WIN 0
#define DEFAULT_MAC 1
#define SCROLL 2

/ {
    /* Behaviors */
    // スクロール設定
    msc {
        acceleration-exponent = <0>;      // 0
        time-to-max-speed-ms = <200>;     // 300
        delay-ms = <5>;                   // 10
    };
    behaviors {
        // エンコーダー：キー
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        // エンコーダー：マウススクロール 
        rot_msc: sensor_rotate_msc {
             compatible = "zmk,behavior-sensor-rotate-var";
             #sensor-binding-cells = <2>;
             tap-ms = <20>;
             bindings = <&msc>, <&msc>;
        };

        // エンコーダー：マウススクロール(MOVE_Y)
        scroll_move_y: sensor_rotate_msc_for_move_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(-20)>;
            // tap-ms下限メモ Yの値で可変: Y(15) <81>, Y(20) <65>, Y(25) <49>
            tap-ms = <65>;
        };

        // エンコーダー：マウススクロール(MOVE_X)
        scroll_move_x: sensor_rotate_msc_for_move_x {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(20)>, <&msc MOVE_X(-20)>;
            // tap-ms下限メモ Xの値で可変: X(15) <81>, X(20) <65>, X(25) <49>
            tap-ms = <65>;
        };


    };

    /* マクロ用 */
    macros {
      pin_login: pin_login {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>; tap-ms = <40>;
        bindings = <&kp N9 &kp N8 &kp N7 &kp N7>;
      };

      rec_key1: rec_key1 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>; tap-ms = <40>;
        bindings = <&kp N0 &kp N3 &kp N0 &kp N8 &kp N9 &kp N9 &kp N0 &kp N4 &kp N1 &kp N0 &kp N1 &kp N9 &kp N5 &kp N7 &kp N3 &kp N9 &kp N4 &kp N7 &kp N0 &kp N2 &kp N3 &kp N0 &kp N6 &kp N7>;      
    };
      rec_key2: rec_key2 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>; tap-ms = <40>;
        bindings = <&kp N3 &kp N1 &kp N3 &kp N9 &kp N9 &kp N5 &kp N4 &kp N9 &kp N2 &kp N0 &kp N1 &kp N9 &kp N2 &kp N4 &kp N7 &kp N0 &kp N4 &kp N9 &kp N0 &kp N2 &kp N1 &kp N2 &kp N7 &kp N4>;      
    };
  };

    /* キーマップ */
    keymap {
        compatible = "zmk,keymap";

        // WINDOWS用
    	DEFAULT_WIN {
            bindings = <
                // Order when USB is on top
                // Keys (Upper-right to Lower-left)
                &kp A    &kp A               &kp A     &rec_key1
                &kp A    &kp C_PLAY_PAUSE    &kp A     &rec_key2
                &kp A    &kp A               &kp A     &pin_login 

                // Mouse (Left, Right)
                &mkp LCLK          &mkp RCLK
                
                // Stick (Up, Left, Down, Right)
                &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mmv MOVE_UP
                
                // Lever (Left-side-left to Right-side-right)
                &kp A &kp A &kp A
                &kp A &kp A &kp A                
                
                // Side (Upper-left, Lower-left, Upper-right, Lower-right)
                 &kp A &kp A &kp A &kp A
                
                // Back (Upper, Lower)
                &bt BT_SEL 0 &bt BT_SEL 1
              >;
            sensor-bindings = <&rot_kp LS(DOT) LS(COMMA)>, <&rot_kp LEFT RIGHT>, <&rot_kp C_VOL_UP C_VOL_DN>;
    	};
    };
};
